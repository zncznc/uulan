[Unit]
Description=lanlink 被控端（X11 采集 + XTest 注入 + 文件/终端/端口映射 + 直连监听）
Documentation=file:@LANLINK_PREFIX@/doc/DESIGN.md
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=RUST_LOG=info
Environment=NO_COLOR=1
ExecStartPre=@LANLINK_PREFIX@/bin/lanlink-wait-x 300
ExecStart=@LANLINK_PREFIX@/bin/lanlink-host --server @LANLINK_SERVER@ --listen 0.0.0.0:21117
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lanlink-host

[Install]
WantedBy=default.target
