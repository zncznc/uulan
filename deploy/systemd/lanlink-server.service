[Unit]
Description=lanlink 中继/信令服务（字节级盲转发）
Documentation=file:@LANLINK_PREFIX@/doc/DESIGN.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@LANLINK_USER@
Group=@LANLINK_GROUP@
ExecStart=@LANLINK_PREFIX@/bin/lanlink-server --bind @LANLINK_BIND@ --state @LANLINK_PREFIX@/state/devices.json
Environment=RUST_LOG=info
Environment=NO_COLOR=1
Restart=always
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@LANLINK_PREFIX@/state
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
