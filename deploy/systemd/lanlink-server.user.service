[Unit]
Description=lanlink 中继/信令服务（用户态安装：全部在 ~/.local/lanlink）
Documentation=file:@LANLINK_PREFIX@/doc/DESIGN.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@LANLINK_PREFIX@/bin/lanlink-server --bind @LANLINK_BIND@ --state @LANLINK_PREFIX@/state/devices.json
Environment=RUST_LOG=info
Environment=NO_COLOR=1
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
